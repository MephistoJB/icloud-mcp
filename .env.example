# Required for HTTP
MCP_AUTH_TOKEN=replace-with-a-long-random-token
ICLOUD_EMAIL=you@icloud.com
ICLOUD_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Network
MCP_LISTEN_ADDRESS=127.0.0.1
MCP_SERVER_PORT=8000
DEFAULT_TZ=Europe/Berlin

# Optional: replace the legacy token with scoped clients. Prefer *_FILE in production.
# MCP_CLIENTS_JSON=[{"id":"reader","token":"...","scopes":["mail:read","calendar:read"]}]
# MCP_CLIENTS_JSON_FILE=/run/secrets/mcp-clients.json

# Outbound actions
EMAIL_SEND_ALLOWLIST=
ENABLE_CALENDAR_WRITE=true
ENABLE_CALENDAR_DELETE=false
ENABLE_CALENDAR_INVITATIONS=false
ENABLE_CONTACTS_WRITE=true
ENABLE_CONTACTS_DELETE=false
ENABLE_MAIL_WRITE=true
ENABLE_MAIL_DELETE=false
ENABLE_PERMANENT_MAIL_DELETE=false
ENABLE_MAIL_SEND=true

# Optional hardening
# RESOURCE_ID_SIGNING_KEY_FILE=/run/secrets/resource-id-key
# AUDIT_HMAC_KEY_FILE=/run/secrets/audit-key
ALLOW_LEGACY_URL_IDS=true
AUDIT_LOG_ENABLED=true
HTTP_TIMEOUT=30
